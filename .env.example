# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# DATABASE URL para a aplicação (DENTRO do container)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# DATABASE URL para desenvolvimento LOCAL (fora do Docker)
# Ajuste a porta se necessário (padrão 5432)
DATABASE_URL_LOCAL=postgresql://auth_user:CHANGE_ME_IN_PRODUCTION@localhost:5432/auth_db?schema=public

# ============================================
# JWT CONFIGURATION
# ============================================
# ⚠️ CRÍTICO: Auth Service e API Service devem usar o MESMO JWT_SECRET
# Use uma chave forte com no mínimo 32 caracteres
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_secreta_super_segura_aqui_32_chars_minimo_mude_em_producao

# Tempo de expiração do token (exemplos: 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# ============================================
# APP CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
